# SERVER
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_NAME=klauscorp_ai
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# REDIS (Cache & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT & SECURITY
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here_123456
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars_123456
JWT_EXPIRE=3600
REFRESH_TOKEN_EXPIRE=604800

# EMAIL CONFIGURATION
SMTP_HOST=smtp.proton.me
SMTP_PORT=587
SMTP_USER=kz95tecnologia@proton.me
SMTP_PASSWORD=your_email_password_here
EMAIL_FROM=noreply@klauscorp.ai

# 2FA / OTP
OTP_WINDOW=30
OTP_STEP=6

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8000,https://klauscorp.ai

# LOGGING
LOG_LEVEL=info
LOG_FILE=./logs/klauscorp.log

# SECURITY
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
SESSION_SECRET=your_session_secret_here_123456

# API RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CRYPTO
RSA_KEY_SIZE=2048
ENCRYPTION_ALGORITHM=aes-256-gcm
